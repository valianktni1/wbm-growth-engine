# Copy this file to .env and replace every CHANGE_ME value.
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
SESSION_SECRET=CHANGE_ME_AT_LEAST_64_RANDOM_CHARACTERS
ADMIN_EMAIL=mark@perfectweddingsbymark.uk
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

APP_URL=https://growth.weddingsbymark.uk
BOOKING_BASE_URL=https://booking.weddingsbymark.uk
BOOKING_ACTION_URL=https://booking.weddingsbymark.uk
BUSINESS_PHONE=07981 150073

# Leave forwarding off until the new enquiry form has been tested end-to-end.
BOOKING_ENQUIRY_FORWARDING=false
BOOKING_WEBHOOK_KEY=CHANGE_ME_SHARED_64_CHARACTER_INTEGRATION_KEY
BOOKING_TIMEOUT_SECONDS=12

# Leave sending off for initial testing. The app will safely prepare follow-ups.
AUTOMATION_SEND_ENABLED=false
FOLLOWUP_APPROVAL_REQUIRED=true
AUTOMATION_SCAN_SECONDS=60
PROPOSAL_DAYS_VALID=7

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=mark@perfectweddingsbymark.uk
SMTP_PASSWORD=CHANGE_ME_MAILBOX_PASSWORD
SMTP_USE_SSL=true
EMAIL_FROM_NAME=Mark at Weddings By Mark

COOKIE_SECURE=true
SESSION_HOURS=12
BACKUP_RETENTION_DAYS=60
